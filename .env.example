# Kopiera den här filen till .env och fyll i värdena från
# Supabase → Project Settings → API
# Anon-nyckeln är gjord för att vara publik (säkerheten sköts av RLS i schema.sql).
# Lägg ALDRIG in service_role-nyckeln här.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe-nycklarna hör INTE hemma här. De sätts på servern med:
#   npx supabase secrets set STRIPE_SECRET_KEY=sk_test_... STRIPE_WEBHOOK_SECRET=whsec_... SITE_URL=...
