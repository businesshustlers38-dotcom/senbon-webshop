# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=5000

# Audio Output Directory
AUDIO_OUTPUT_DIR=./audio_output

# Hugging Face Configuration
# Get token from https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# If behind a proxy, set these:
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080

# Proxy settings for HuggingFace Hub
# HF_HOME=/path/to/cache  # Custom cache directory
# HF_DATASETS_OFFLINE=0   # Set to 1 to use only offline cache
